{
  "name": "@cookiemunch/testing",
  "version": "0.1.1",
  "description": "Test helpers for sites running Cookie Munch: an official versioned stub of the embed's API, preview links, and a helper that answers the real banner",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cookie-Munch/testing.git"
  },
  "homepage": "https://cookiemunch.net/docs/testing",
  "bugs": {
    "url": "https://github.com/Cookie-Munch/testing/issues"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
